{
  "name": "dwc-gcode-core",
  "version": "0.1.0",
  "type": "module",
  "description": "RepRapFirmware-faithful G-code parsing for DuetWebControl plugins: an allocation-light line tokeniser, parameter parsing and in-place rewriting, and a small table of what specific commands mean (G10's three forms, M568, which P parameters are tool numbers), each entry cited against RRF source at a named release. Pure TypeScript, zero dependencies, no Vue or DWC imports; bundled into each plugin.",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/jaysuk/dwc-gcode-core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysuk/dwc-gcode-core.git"
  },
  "rrf": {
    "baseline": "3.7.0-rc.1"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lex": {
      "types": "./dist/lex.d.ts",
      "import": "./dist/lex.js"
    },
    "./params": {
      "types": "./dist/params.d.ts",
      "import": "./dist/params.js"
    },
    "./commands/*": {
      "types": "./dist/commands/*.d.ts",
      "import": "./dist/commands/*.js"
    },
    "./rrf": {
      "types": "./dist/rrf.d.ts",
      "import": "./dist/rrf.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "triage": "node scripts/rrf-triage.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "typesVersions": {
    "*": {
      "*": [
        "dist/*"
      ]
    }
  }
}
